{
  "name": "lol-wiki-monorepo",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/meesvandongen/lol-wiki-md.git"
  },
  "homepage": "https://github.com/meesvandongen/lol-wiki-md",
  "workspaces": [
    "apps/docs",
    "apps/llm-pack"
  ],
  "scripts": {
    "download": "node ./scripts/run-export-wiki.mjs",
    "download:wiki": "node ./scripts/run-export-wiki.mjs",
    "convert": "node ./scripts/run-convert.mjs",
    "convert:champions": "npm run convert -- --all-champions",
    "convert:fresh": "npm run download && npm run convert",
    "convert:items": "npm run convert -- --all-items",
    "convert:runes": "npm run convert -- --all-runes",
    "audit:similarity": "cargo run -p lol_wiki_md --bin audit_similarity --",
    "export:wiki": "node ./scripts/run-export-wiki.mjs",
    "docs:sync": "node ./scripts/sync-rspress-content.mjs",
    "docs:build": "npm run docs:sync && npm run build --workspace @lol-wiki/docs",
    "docs:dev": "npm run dev --workspace @lol-wiki/docs",
    "docs:fresh": "npm run convert:fresh && npm run docs:build",
    "docs:worker:dev": "node ./node_modules/wrangler/bin/wrangler.js dev --config ./apps/docs/wrangler.jsonc",
    "docs:worker:deploy": "node ./scripts/publish-wrangler.mjs",
    "docs:publish": "npm run docs:build && node ./scripts/publish-wrangler.mjs",
    "llm:build": "node ./apps/llm-pack/src/cli.mjs build",
    "llm:fresh": "npm run convert && npm run llm:build",
    "llm:search": "node ./apps/llm-pack/src/cli.mjs search",
    "llm:mcp": "node ./apps/llm-pack/src/mcp-server.mjs",
    "llm:test": "npm test --workspace @lol-wiki/llm-pack",
    "pipeline": "node ./scripts/run-pipeline.mjs",
    "pipeline:sh": "bash ./scripts/pipeline.sh",
    "pipeline:ps": "pwsh ./scripts/pipeline.ps1"
  },
  "devDependencies": {
    "wrangler": "^4.67.3"
  }
}